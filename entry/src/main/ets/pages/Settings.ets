import { curves } from '@kit.ArkUI';
import { MusicStore } from '../services/MusicStore';
import { SettingsStore } from '../utils/SettingsStore';
import { ThemeManager, ColorTokens } from '../utils/ThemeManager';
import { SettingsCategoryDetail } from './SettingsCategory';
import {
  ManageSongsBody,
  DuplicateSongsBody,
  WrappedBody,
  PrivacyPolicyBody
} from '../components/SettingsSubPageBodies';
import { TYPE_SM, SPACE_SM } from '../tokens/LumioScale';
import uiMaterial from '@ohos.arkui.uiMaterial';
import { acquireSheetMaterial, SheetScaffold } from '../common/utils/SheetMaterial';

interface SettingsCategoryParam {
  category: string;
}

interface CategoryItem {
  id: string;
  title: ResourceStr;
  subtitle: ResourceStr;
  icon: ResourceStr;
  iconColor: string;
}

@Builder
export function SettingsBuilder() {
  NavDestination() {
    Settings({})
  }
  .hideTitleBar(true)
}

@Component
export struct Settings {
  /** 由外层（Mine 的 bindSheet）传入：关闭整个设置 sheet。 */
  onRequestClose: () => void = () => {};
  /** 当前选中的子分类；'' 表示根列表。用于 sheet 内二级导航（无需再开一个 NavDestination）。 */
  @State selectedCategory: string = '';
  /** Settings sheet 内嵌子页（避免关闭 sheet 再开主导航栈）；'' 表示无子页。 */
  @State subPage: string = '';
  store: MusicStore = MusicStore.getInstance();
  settings: SettingsStore = SettingsStore.getInstance();
  @StorageProp('topHeight') topHeight: number = 0;
  @StorageProp('isDark') isDark: boolean = false;
  /** 系统材质实例：API 26 经动态 import 注入；API 24 恒为 undefined（SheetScaffold 走纯色兜底）。 */
  @State material: uiMaterial.Material | undefined = undefined;

  /** 主题响应式：跟随应用浅色/深色主题（sheet 内页面与全局一致，不强制灰底白字）。 */
  private getThemeColors(): ColorTokens {
    return this.isDark ? ThemeManager.darkColors : ThemeManager.lightColors;
  }

  aboutToAppear(): void {
    acquireSheetMaterial().then((m: uiMaterial.Material | undefined): void => {
      this.material = m;
    });
  }

  /**
   * 设置分类入口。
   */
  private categories(): Array<CategoryItem> {
    return [
      { id: 'playback', title: $r('app.string.play'), subtitle: $r('app.string.auto_next_mode'), icon: $r('app.media.ic_public_list_cycle'), iconColor: this.getThemeColors().secondaryText },
      { id: 'audio', title: $r('app.string.sound_effects'), subtitle: $r('app.string.crossfade'), icon: $r('app.media.ic_public_sound'), iconColor: this.getThemeColors().secondaryText },
      { id: 'appearance', title: $r('app.string.ui'), subtitle: $r('app.string.dark_mode_theme'), icon: $r('app.media.ic_public_themes'), iconColor: this.getThemeColors().secondaryText },
      { id: 'accessibility', title: $r('app.string.accessibility'), subtitle: $r('app.string.reduce_motion'), icon: $r('app.media.ic_public_face'), iconColor: this.getThemeColors().secondaryText },
      { id: 'storage', title: $r('app.string.storage'), subtitle: $r('app.string.cache_history_mgmt'), icon: $r('app.media.ic_public_delete'), iconColor: this.getThemeColors().secondaryText },
      { id: 'notification', title: $r('app.string.notifications'), subtitle: $r('app.string.lockscreen_control'), icon: $r('app.media.ic_public_donotdisturb'), iconColor: this.getThemeColors().secondaryText },
      { id: 'privacy', title: $r('app.string.privacy'), subtitle: $r('app.string.listen_stats'), icon: $r('app.media.ic_public_favor_filled'), iconColor: this.getThemeColors().secondaryText }
    ];
  }

  private currentTitle(): ResourceStr {
    if (this.subPage !== '') {
      return this.subPageTitle(this.subPage);
    }
    if (this.selectedCategory === '') {
      return $r('app.string.settings');
    }
    const found = this.categories().find((c: CategoryItem) => c.id === this.selectedCategory);
    return found ? found.title : $r('app.string.settings');
  }

  private subPageTitle(kind: string): ResourceStr {
    switch (kind) {
      case 'manage': return $r('app.string.local_songs_mgmt');
      case 'duplicate': return $r('app.string.dup_cleanup');
      case 'wrapped': return $r('app.string.listen_report');
      case 'privacy': return $r('app.string.privacy_policy');
      default: return $r('app.string.settings');
    }
  }

  /**
   * sheet 内统一返回：优先退出 subPage，再退出 selectedCategory，最后关闭整个 sheet。
   * 系统返回手势（侧滑/虚拟返回键）应只回退这一层栈，而不是直接关掉设置 sheet。
   */
  goBackInSheet(): void {
    if (this.subPage !== '') {
      // 关闭 subPage 回到分类页或设置根
      this.getUIContext().animateTo(
        { curve: curves.interpolatingSpring(0, 1, 360, 36), duration: 240 },
        () => {
          this.subPage = '';
        }
      );
      return;
    }
    if (this.selectedCategory !== '') {
      this.getUIContext().animateTo(
        { curve: curves.interpolatingSpring(0, 1, 360, 36), duration: 240 },
        () => {
          this.selectedCategory = '';
        }
      );
      return;
    }
    // 设置根：关闭 sheet（外层 Mine 处理）
    this.onRequestClose();
  }

  /** 进入 subPage：sheet 内动画切到对应子页（管理/重复/听歌报告/隐私政策）。 */
  openSubPage(kind: string): void {
    if (this.subPage === kind) {
      return;
    }
    this.getUIContext().animateTo(
      { curve: curves.interpolatingSpring(0, 1, 360, 36), duration: 280 },
      () => {
        this.subPage = kind;
      }
    );
  }

  build() {
    SheetScaffold({ material: this.material, fallbackColor: this.getThemeColors().surfaceOverlay }) {
      Column() {
        // 头部：返回箭头在二级页显示，标题随状态切换
        Row() {
        if (this.subPage !== '' || this.selectedCategory !== '') {
          Image($r('app.media.ic_public_arrow_left'))
            .width(24)
            .height(24)
            .fillColor(this.getThemeColors().primaryText)
            .onClick(() => this.goBackInSheet()).clickEffect({ level: ClickEffectLevel.LIGHT, scale: 0.96 })
        }
        Text(this.currentTitle())
          .fontSize(TYPE_SM.title2.size)
          .fontWeight(FontWeight.Bold)
          .fontColor(this.getThemeColors().primaryText)
          .margin({ left: (this.subPage !== '' || this.selectedCategory !== '') ? 12 : 0 })
          .layoutWeight(1)
      }
      .width('100%')
      .padding({ left: SPACE_SM.base, right: SPACE_SM.base, top: this.topHeight + 12, bottom: SPACE_SM.base })

      // 渲染优先级：subPage > selectedCategory > 根列表
      if (this.subPage === 'manage') {
        ManageSongsBody({ onBack: () => this.goBackInSheet(), showHeader: false })
          .layoutWeight(1)
          .transition(TransitionEffect.OPACITY.combine(TransitionEffect.translate({ x: 32 })))
      } else if (this.subPage === 'duplicate') {
        DuplicateSongsBody({ onBack: () => this.goBackInSheet(), showHeader: false })
          .layoutWeight(1)
          .transition(TransitionEffect.OPACITY.combine(TransitionEffect.translate({ x: 32 })))
      } else if (this.subPage === 'wrapped') {
        WrappedBody({ onBack: () => this.goBackInSheet(), showHeader: false })
          .layoutWeight(1)
          .transition(TransitionEffect.OPACITY.combine(TransitionEffect.translate({ x: 32 })))
      } else if (this.subPage === 'privacy') {
        PrivacyPolicyBody({ onBack: () => this.goBackInSheet(), showHeader: false })
          .layoutWeight(1)
          .transition(TransitionEffect.OPACITY.combine(TransitionEffect.translate({ x: 32 })))
      } else if (this.selectedCategory === '') {
        Scroll() {
          Column() {
            Column() {
              ForEach(this.categories(), (cat: CategoryItem) => {
                this.buildCategoryItem(cat);
              }, (cat: CategoryItem): string => cat.id)
            }
            .margin({ bottom: SPACE_SM.compact })

            Text('Made with HarmonyOS SDK')
              .fontSize(TYPE_SM.caption1.size)
              .fontColor(this.getThemeColors().secondaryText)
              .margin({ top: SPACE_SM.loose, bottom: SPACE_SM.roomy })
          }
          .width('100%')
          .padding({ left: SPACE_SM.base, right: SPACE_SM.base, bottom: SPACE_SM.block })
        }
        .layoutWeight(1)
        .scrollBar(BarState.Off)
        .transition(TransitionEffect.OPACITY.combine(TransitionEffect.translate({ x: -24 })))
      } else {
        SettingsCategoryDetail({
          category: this.selectedCategory,
          onBack: () => this.goBackInSheet(),
          onNavigate: (name: string) => this.openSubPage(this.routeToSubPage(name))
        })
          .layoutWeight(1)
          .transition(TransitionEffect.OPACITY.combine(TransitionEffect.translate({ x: 24 })))
      }
    }
    .width('100%')
    .height('100%')
    .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
    }
  }

  /** 把分类页中 onNavigate 调用的目标名映射到 sheet 内 subPage。 */
  private routeToSubPage(name: string): string {
    if (name === 'ManageSongs') {
      return 'manage';
    }
    if (name === 'DuplicateSongs') {
      return 'duplicate';
    }
    if (name === 'Wrapped') {
      return 'wrapped';
    }
    if (name === 'PrivacyPolicy') {
      return 'privacy';
    }
    return '';
  }

  @Builder
  buildCategoryItem(cat: CategoryItem) {
    Row() {
      Image(cat.icon)
        .width(24)
        .height(24)
        .fillColor(cat.iconColor)
        .margin({ right: SPACE_SM.base })

      Column() {
        Text(cat.title)
          .fontSize(TYPE_SM.headline.size)
          .fontColor(this.getThemeColors().primaryText)
          .fontWeight(FontWeight.Medium)
          .margin({ bottom: SPACE_SM.tight })
        Text(cat.subtitle)
          .fontSize(TYPE_SM.footnote.size)
          .fontColor(this.getThemeColors().secondaryText)
      }
      .alignItems(HorizontalAlign.Start)
      .layoutWeight(1)

      Image($r('app.media.ic_public_more'))
        .width(16)
        .fillColor(this.getThemeColors().separator)
    }
    .width('100%')
    .height(64)
    .padding({ left: SPACE_SM.base, right: SPACE_SM.base })
    .backgroundColor(this.getThemeColors().cardBg)
    .borderRadius(16)
    .margin({ bottom: SPACE_SM.hair })
    .onClick(() => {
      this.getUIContext().animateTo(
        { curve: curves.interpolatingSpring(0, 1, 360, 36), duration: 240 },
        () => {
          this.selectedCategory = cat.id;
        }
      );
    }).clickEffect({ level: ClickEffectLevel.LIGHT, scale: 0.96 })
  }
}
