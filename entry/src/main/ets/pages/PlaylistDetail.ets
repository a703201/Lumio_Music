import { SongItem, Playlist } from '../models/music';
import { SongDataSource } from '../datasource/SongDataSource';
import { ThemeManager, ColorTokens } from '../utils/ThemeManager';
import { MusicStore } from '../services/MusicStore';
import { AudioRendererController } from '../utils/AudioRendererController';
import { Logger } from '../utils/Logger';
import { CoverImageView } from '../components/CoverImageView';
import { QualityBadge } from '../components/QualityBadge';
import { SongDetailSheet } from '../components/SongDetailSheet';
import { AddToPlaylistSheet } from '../components/AddToPlaylistSheet';
import { SettingsStore } from '../utils/SettingsStore';
import { semanticOf } from '../tokens/LumioColor';
import { SongRow, SongMenuEntry } from '../components/SongRow';
import { ShareUtil } from '../utils/ShareUtil';
import { LumioTheme, SpringKind } from '../tokens/LumioTheme';
import { TYPE_SM, SPACE_SM } from '../tokens/LumioScale';
import uiMaterial from '@ohos.arkui.uiMaterial';
import { acquireSheetMaterial, SheetScaffold } from '../common/utils/SheetMaterial';

const TAG: string = 'PlaylistDetail';

@Builder
export function PlaylistDetailBuilder() {
  PlaylistDetail()
}

/**
 * 歌单详情页。
 * 入参：路由参数（context.pathInfo.param）传入歌单 id（string），页面内按 id 从 MusicStore 实时取，
 * 不缓存 Playlist 对象副本，避免与数据层状态漂移。
 */
@Component
struct PlaylistDetail {
  pathStack: NavPathStack = new NavPathStack();
  store: MusicStore = MusicStore.getInstance();
  @StorageProp('topHeight') topHeight: number = 0;
  @StorageProp('bottomHeight') bottomHeight: number = 0;
  @StorageProp('isDark') isDark: boolean = false;
  @StorageProp('coverRefreshToken') @Watch('onCoverRefreshed') coverRefreshToken: number = 0;

  @State playlistId: string = '';
  @State playlistName: string = '';
  @State @Watch('onSongsChanged') songs: SongItem[] = [];
  private songsDataSource: SongDataSource = new SongDataSource([]);

  onSongsChanged(): void {
    this.songsDataSource.setData(this.songs);
  }
  @State itemScales: number[] = [];
  @State backScale: number = 1.0;
  @State playAllScale: number = 1.0;
  @State selectedSong: SongItem | undefined = undefined;
  @State sheetOpen: boolean = false;
  @State sheetKind: 'detail' | 'add' | 'picker' = 'detail';
  /** 系统材质实例：API 26 经动态 import 注入；API 24 恒为 undefined（SheetScaffold 走纯色兜底）。 */
  @State material: uiMaterial.Material | undefined = undefined;

  // 添加歌曲面板
  @State candidates: SongItem[] = [];
  @State selectedIds: number[] = [];

  private getThemeColors(): ColorTokens {
    return this.isDark ? ThemeManager.darkColors : ThemeManager.lightColors;
  }

  aboutToAppear(): void {
    acquireSheetMaterial().then((m: uiMaterial.Material | undefined): void => {
      this.material = m;
    });
  }

  onCoverRefreshed(): void {
    this.reload();
  }

  private reload(): void {
    const playlist: Playlist | undefined = this.store.getPlaylistById(this.playlistId);
    if (!playlist) {
      this.playlistName = '';
      this.songs = [];
      this.itemScales = [];
      return;
    }
    this.playlistName = playlist.name;
    // 按歌单内 songIds 的顺序展示，而不是本地库顺序
    const byId: Map<number, SongItem> = new Map<number, SongItem>();
    this.store.songs.forEach((s: SongItem) => byId.set(s.id, s));
    const ordered: SongItem[] = [];
    playlist.songIds.forEach((id: number) => {
      const hit: SongItem | undefined = byId.get(id);
      if (hit) {
        ordered.push(hit);
      }
    });
    this.songs = ordered;
    this.itemScales = ordered.map(() => 1.0);
  }

  private toast(message: string | Resource): void {
    try {
      this.getUIContext().getPromptAction().showToast({ message });
    } catch (e) {
      Logger.error(TAG, 'toast failed');
    }
  }

  private getCoverSrc(song: SongItem): string {
    return song.src;
  }

  /** 列表入场错峰延迟：降低动态效果开启时取消错峰（R-18/F-13）。 */
  private entryDelay(index: number): number {
    return SettingsStore.getInstance().getReduceMotion() ? 0 : index * 40;
  }

  private playAll(): void {
    if (this.songs.length === 0) {
      this.toast($r('app.string.playlist_empty'));
      return;
    }
    AudioRendererController.getInstance().setQueue(this.songs, 0, true);
    this.pathStack.pushPathByName('PlayerPage', null);
  }

  private playAt(index: number): void {
    if (index < 0 || index >= this.songs.length) {
      return;
    }
    AudioRendererController.getInstance().setQueue(this.songs, index, true);
    this.pathStack.pushPathByName('PlayerPage', null);
  }

  private confirmRemove(song: SongItem): void {
    const songId: number = song.id;
    const title: string = song.title;
    this.getUIContext().showAlertDialog({
      title: $r('app.string.move_out_playlist'),
      message: `将「${title}」移出本歌单？歌曲仍保留在本地库。`,
      primaryButton: { value: $r('app.string.cancel'), action: () => {} },
      secondaryButton: {
        value: $r('app.string.move_out'),
        action: () => {
          this.store.removeSongFromPlaylist(this.playlistId, songId);
          this.reload();
          this.toast($r('app.string.moved_out'));
        }
      }
    });
  }

  private toggleFavoriteSong(song: SongItem): void {
    const isFav: boolean = this.store.isFavorite(song.id);
    this.store.toggleFavorite(song.id);
    try {
      this.getUIContext().getPromptAction().showToast({
        message: isFav ? $r('app.string.unfavorited') : $r('app.string.favorited')
      });
    } catch (e) {
      Logger.error('PlaylistDetail', 'showToast failed');
    }
  }

  private openAddToPlaylist(song: SongItem): void {
    this.selectedSong = song;
    this.sheetKind = 'add';
    this.sheetOpen = true;
  }

  /** 把当前歌单导出为 .m3u（经系统文件选择器落盘，不申请存储权限）。 */
  private async onExport(): Promise<void> {
    const playlist = this.store.getPlaylistById(this.playlistId);
    if (!playlist) {
      return;
    }
    const ok: boolean = await ShareUtil.exportPlaylist(playlist);
    this.toast(ok ? $r('app.string.playlist_exported') : $r('app.string.export_canceled'));
  }

  private openSongDetail(song: SongItem): void {
    this.selectedSong = song;
    this.sheetKind = 'detail';
    this.sheetOpen = true;
  }

    private buildMenuItems(song: SongItem, index: number): SongMenuEntry[] {
    return [
      { text: $r('app.string.play'), icon: $r('app.media.ic_lib_play'), action: () => { this.playAt(index); } },
      { text: this.store.isFavorite(song.id) ? $r('app.string.unfavorite') : $r('app.string.favorite'), icon: $r('app.media.ic_public_collect'), action: () => { this.toggleFavoriteSong(song); } },
      { text: $r('app.string.add_to_playlist'), icon: $r('app.media.ic_public_add'), action: () => { this.openAddToPlaylist(song); } },
      { text: $r('app.string.details'), icon: $r('app.media.ic_public_detail'), action: () => { this.openSongDetail(song); } }
    ];
  }


  /**
   * 打开「添加歌曲」面板：候选集为本地库中尚未加入本歌单的歌曲。
   */
  private openPicker(): void {
    const playlist: Playlist | undefined = this.store.getPlaylistById(this.playlistId);
    if (!playlist) {
      return;
    }
    const existing: Set<number> = new Set<number>(playlist.songIds);
    this.candidates = this.store.songs.filter((s: SongItem) => !existing.has(s.id));
    this.selectedIds = [];
    if (this.candidates.length === 0) {
      this.toast($r('app.string.all_in_playlist'));
      return;
    }
    this.sheetKind = 'picker';
    this.sheetOpen = true;
  }

  /**
   * 拖拽重排落点处理（FR-24）。
   * 采用 ArkUI 官方 ForEach.onMove（API 12+）：框架内建长按拖拽手势、占位动画与落点计算，
   * 回调直接给出 from / to 语义索引，无需手工处理 onDragStart / onDrop / extraParams。
   * 这里只做数据层持久化重排，UI 由 reload() 依据 MusicStore 的新顺序重建，保证单一数据源。
   */
  private handleMove(from: number, to: number): void {
    if (from === to) {
      return;
    }
    this.store.reorderPlaylistSongs(this.playlistId, from, to);
    this.reload();
  }

  private toggleSelect(songId: number): void {
    if (this.selectedIds.includes(songId)) {
      this.selectedIds = this.selectedIds.filter((id: number) => id !== songId);
    } else {
      this.selectedIds = [...this.selectedIds, songId];
    }
  }

  private commitAdd(): void {
    if (this.selectedIds.length === 0) {
      this.toast($r('app.string.select_first'));
      return;
    }
    const added: number = this.store.addSongsToPlaylist(this.playlistId, this.selectedIds);
    this.sheetOpen = false;
    this.reload();
    this.toast(`已添加 ${added} 首`);
  }

  @Builder
  songPickerBuilder() {
    SheetScaffold({ material: this.material, fallbackColor: this.getThemeColors().surfaceOverlay }) {
      Column() {
        Row() {
          Text($r('app.string.add_songs'))
          .fontSize(TYPE_SM.title3.size)
          .fontWeight(FontWeight.Bold)
          .fontColor(this.getThemeColors().primaryText)
          .layoutWeight(1)

        Text(`已选 ${this.selectedIds.length}`)
          .fontSize(TYPE_SM.footnote.size)
          .fontColor(this.getThemeColors().secondaryText)
      }
      .width('100%')
      .padding({ left: SPACE_SM.base, right: SPACE_SM.base, top: SPACE_SM.base, bottom: SPACE_SM.cozy })

      List() {
        ForEach(this.candidates, (song: SongItem) => {
          ListItem() {
            Row() {
              CoverImageView({ src: this.getCoverSrc(song), coverSize: 40, coverRadius: 8 })

              Column() {
                Text(song.title)
                  .fontSize(TYPE_SM.body.size)
                  .fontColor(this.getThemeColors().primaryText)
                  .maxLines(1)
                  .textOverflow({ overflow: TextOverflow.Ellipsis })

                Text(song.singer)
                  .fontSize(TYPE_SM.caption1.size)
                  .fontColor(this.getThemeColors().secondaryText)
                  .margin({ top: SPACE_SM.hair })
                  .maxLines(1)
                  .textOverflow({ overflow: TextOverflow.Ellipsis })
              }
              .layoutWeight(1)
              .alignItems(HorizontalAlign.Start)
              .padding({ left: SPACE_SM.cozy, right: SPACE_SM.compact })

              Checkbox()
                .select(this.selectedIds.includes(song.id))
                .selectedColor(this.getThemeColors().accent)
                .hitTestBehavior(HitTestMode.None) // P1-8：勾选框只做视觉呈现，统一由父 Row 点击驱动，避免事件冒泡双触发
            }
            .width('100%')
            .height(60)
            .padding({ left: SPACE_SM.base, right: SPACE_SM.base })
            .onClick(() => {
              this.toggleSelect(song.id);
            })
          }
        }, (song: SongItem): string => `${song.id}`)
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)

      Row() {
        Button($r('app.string.cancel'))
          .layoutWeight(1)
          .height(42)
          .fontSize(TYPE_SM.body.size)
          .fontColor(this.getThemeColors().secondaryText)
          .backgroundColor(this.getThemeColors().secondaryBg)
          .borderRadius(21)
        .onClick(() => {
          this.sheetOpen = false;
        })

        Button($r('app.string.add'))
          .layoutWeight(1)
          .height(42)
          .fontSize(TYPE_SM.body.size)
          .fontColor(semanticOf(this.isDark).onAccent)
          .backgroundColor(this.getThemeColors().accent)
          .borderRadius(21)
          .margin({ left: SPACE_SM.cozy })
          .onClick(() => {
            this.commitAdd();
          })
      }
      .width('100%')
      .padding({ left: SPACE_SM.base, right: SPACE_SM.base, top: SPACE_SM.cozy, bottom: SPACE_SM.roomy })
    }
    .width('100%')
    .height('100%')
    }
  }

  

  build() {
    NavDestination() {
      Column() {
        // Header
        Row() {
          Image($r('app.media.ic_public_arrow_left'))
            .width(24)
            .height(24)
            .fillColor(this.getThemeColors().primaryText)
            .scale({ x: this.backScale, y: this.backScale })
            .animation({ duration: 150, curve: LumioTheme.curve(SpringKind.Crisp) })
            .onClick(() => {
              this.pathStack.pop();
            })
            .onTouch((event: TouchEvent) => {
              if (event.type === TouchType.Down) {
                this.backScale = 0.8;
              } else if (event.type === TouchType.Up || event.type === TouchType.Cancel) {
                this.backScale = 1.0;
              }
            })

          Text(this.playlistName.length > 0 ? this.playlistName : $r('app.string.playlist'))
            .fontSize(TYPE_SM.title2.size)
            .fontWeight(FontWeight.Bold)
            .fontColor(this.getThemeColors().primaryText)
            .margin({ left: SPACE_SM.cozy })
            .layoutWeight(1)
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })

          Text(`${this.songs.length} 首`)
            .fontSize(TYPE_SM.footnote.size)
            .fontColor(this.getThemeColors().accent)
            .backgroundColor(semanticOf(this.isDark).fillAccentSoft)
            .borderRadius(12)
            .padding({ left: SPACE_SM.cozy, right: SPACE_SM.cozy, top: SPACE_SM.tight, bottom: SPACE_SM.tight })
        }
        .width('100%')
        .padding({ left: SPACE_SM.base, right: SPACE_SM.base, top: this.topHeight + 12, bottom: SPACE_SM.cozy })

        // 操作区：播放全部 / 添加歌曲
        Row() {
          Row() {
            Image($r('app.media.ic_lib_play'))
              .width(20)
              .height(20)
              .fillColor(semanticOf(this.isDark).onAccent)
            Text($r('app.string.play_all'))
              .fontSize(TYPE_SM.subhead.size)
              .fontColor(semanticOf(this.isDark).onAccent)
              .margin({ left: SPACE_SM.compact })
          }
          .layoutWeight(1)
          .height(40)
          .justifyContent(FlexAlign.Center)
          .backgroundColor(this.getThemeColors().accent)
          .borderRadius(24)
          .scale({ x: this.playAllScale, y: this.playAllScale })
          .animation({ duration: 150, curve: LumioTheme.curve(SpringKind.Crisp) })
          .onClick(() => {
            this.playAll();
          })
          .onTouch((event: TouchEvent) => {
            if (event.type === TouchType.Down) {
              this.playAllScale = 0.97;
            } else if (event.type === TouchType.Up || event.type === TouchType.Cancel) {
              this.playAllScale = 1.0;
            }
          })

          Row() {
            Text('+')
              .fontSize(TYPE_SM.title3.size)
              .fontColor(this.getThemeColors().primaryText)
            Text($r('app.string.add_songs'))
              .fontSize(TYPE_SM.subhead.size)
              .fontColor(this.getThemeColors().primaryText)
              .margin({ left: SPACE_SM.compact })
          }
          .layoutWeight(1)
          .height(40)
          .justifyContent(FlexAlign.Center)
          .backgroundColor(this.getThemeColors().cardBg)
          .borderRadius(24)
          .margin({ left: SPACE_SM.cozy })
          .onClick(() => {
            this.openPicker();
          })

          Row() {
            Text($r('app.string.export'))
              .fontSize(TYPE_SM.subhead.size)
              .fontColor(this.getThemeColors().primaryText)
          }
          .layoutWeight(1)
          .height(40)
          .justifyContent(FlexAlign.Center)
          .backgroundColor(this.getThemeColors().cardBg)
          .borderRadius(24)
          .margin({ left: SPACE_SM.cozy })
          .onClick(() => {
            this.onExport();
          })
        }
        .width('100%')
        .padding({ left: SPACE_SM.base, right: SPACE_SM.base, bottom: SPACE_SM.cozy })

        if (this.songs.length > 0) {
          Text($r('app.string.long_press_hint'))
            .fontSize(TYPE_SM.caption1.size)
            .fontColor(this.getThemeColors().secondaryText)
            .margin({ left: SPACE_SM.base, bottom: SPACE_SM.tight })
        }

        if (this.songs.length === 0) {
          Column() {
            Image($r('app.media.ic_public_view_list'))
              .width(64)
              .height(64)
              .fillColor(this.getThemeColors().secondaryText)
              .margin({ bottom: SPACE_SM.base })

            Text($r('app.string.playlist_empty'))
              .fontSize(TYPE_SM.headline.size)
              .fontColor(this.getThemeColors().secondaryText)
              .fontWeight(FontWeight.Medium)

            Text($r('app.string.add_from_lib_hint'))
              .fontSize(TYPE_SM.footnote.size)
              .fontColor(semanticOf(this.isDark).labelSecondary)
              .margin({ top: SPACE_SM.compact })
          }
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
        } else {
          List() {
            LazyForEach(this.songsDataSource, (song: SongItem, index: number) => {
              ListItem() {
                SongRow({
              song: song,
              index: index,
              playing: false,
              showIndex: true,
              showQuality: true,
              showRemove: true,
              coverSize: 48,
              titleFontSize: 15,
              rowHeight: 64,
              leftPadding: 8,
              animateEntry: true,
              entryDelayMs: this.entryDelay(index),
              menuItems: this.buildMenuItems(song, index),
              onPlay: () => {
                this.playAt(index);
              },
              onRemove: () => {
                this.confirmRemove(song);
              }
            })
              }
            }, (song: SongItem): string => `${song.id}`)
              .onMove((from: number, to: number): void => {
                this.handleMove(from, to);
              })
          }
          .width('100%')
          .layoutWeight(1)
          .scrollBar(BarState.Off)
          .padding({ bottom: this.bottomHeight + 16 })
        }
      }
      .width('100%')
      .height('100%')
      .backgroundColor(this.getThemeColors().bg)
      .bindSheet($$this.sheetOpen, this.sheetContent(), {
        detents: [SheetSize.MEDIUM, SheetSize.LARGE],
        dragBar: true,
        showClose: true,
        backgroundColor: this.getThemeColors().surfaceOverlay,
        preferType: SheetType.BOTTOM
      })
    }
    .onReady((context: NavDestinationContext) => {
      this.pathStack = context.pathStack;
      const param: Object = context.pathInfo.param as Object;
      if (typeof param === 'string') {
        this.playlistId = param as string;
      } else {
        Logger.warn(TAG, 'PlaylistDetail: invalid route param, expected playlist id string');
      }
      this.reload();
    })
    .hideTitleBar(true)
  }

  @Builder
  sheetContent() {
    if (this.sheetKind === 'detail') {
      SongDetailSheet({ songId: this.selectedSong?.id ?? 0, pathStack: this.pathStack })
    } else if (this.sheetKind === 'add') {
      AddToPlaylistSheet({
        songId: this.selectedSong?.id ?? 0,
        onClose: () => {
          this.sheetOpen = false;
        }
      })
    } else if (this.sheetKind === 'picker') {
      this.songPickerBuilder()
    }
  }
}
