import { ThemeManager, ColorTokens } from '../utils/ThemeManager';
import { semanticOf } from '../tokens/LumioColor';
import { LumioTheme, SpringKind } from '../tokens/LumioTheme';
import { TYPE_SM, SPACE_SM } from '../tokens/LumioScale';
import uiMaterial from '@ohos.arkui.uiMaterial';
import { acquireSheetMaterial, SheetScaffold } from '../common/utils/SheetMaterial';

interface OnboardFeature {
  icon: ResourceStr;
  title: ResourceStr;
  desc: ResourceStr;
}

/**
 * 首次引导页内容（半蒙面 Sheet 内嵌）。展示核心功能亮点，
 * 底部「开始体验」按钮关闭引导。被 Layout 的 bindSheet 承载。
 */
@Component
export struct OnboardingSheet {
  onClose: () => void = () => {};
  @StorageProp('isDark') isDark: boolean = false;
  /** 系统材质实例：API 26 经动态 import 注入；API 24 恒为 undefined（SheetScaffold 走纯色兜底）。 */
  @State material: uiMaterial.Material | undefined = undefined;

  @State itemOpacities: number[] = [0, 0, 0, 0];
  @State itemScales: number[] = [0.9, 0.9, 0.9, 0.9];

  private getThemeColors(): ColorTokens {
    return this.isDark ? ThemeManager.darkColors : ThemeManager.lightColors;
  }

  /**
   * 特性列表。用方法而非字段：颜色依赖 @StorageProp('isDark')，
   * 字段初始化只在构造时求值一次，切主题不会重算（warning/success 深浅值不同 → 会滞留）。
   */
  private features(): OnboardFeature[] {
    return [
      { icon: $r('app.media.ic_public_albums'), title: $r('app.string.onboard_local'), desc: $r('app.string.onboard_local_desc') },
      { icon: $r('app.media.ic_public_favor'), title: $r('app.string.onboard_lossless'), desc: $r('app.string.onboard_lossless_desc') },
      { icon: $r('app.media.ic_public_view_list'), title: $r('app.string.smart_playlist'), desc: $r('app.string.onboard_smart_desc') },
      { icon: $r('app.media.ic_lib_play'), title: $r('app.string.onboard_system'), desc: $r('app.string.onboard_system_desc') }
    ];
  }

  aboutToAppear(): void {
    acquireSheetMaterial().then((m: uiMaterial.Material | undefined): void => {
      this.material = m;
    });
    for (let i = 0; i < this.features().length; i++) {
      setTimeout(() => {
        const op = [...this.itemOpacities];
        const sc = [...this.itemScales];
        op[i] = 1.0;
        sc[i] = 1.0;
        this.itemOpacities = op;
        this.itemScales = sc;
      }, 200 + i * 120);
    }
  }

  @Builder
  private featureItem(f: OnboardFeature, index: number) {
    Row() {
      Stack() {
        Image(f.icon)
          .width(24)
          .height(24)
          .fillColor(semanticOf(this.isDark).accent)
      }
      .width(46)
      .height(46)
      .borderRadius(16)
      .backgroundColor(semanticOf(this.isDark).fillAccentSubtle)
      .align(Alignment.Center)

      Column() {
        Text(f.title)
          .fontSize(TYPE_SM.headline.size)
          .fontWeight(FontWeight.Medium)
          .lineHeight(TYPE_SM.headline.lineHeight)
          .letterSpacing(TYPE_SM.headline.tracking)
          .fontColor(this.getThemeColors().primaryText)
        Text(f.desc)
          .fontSize(TYPE_SM.caption1.size)
          .fontColor(this.getThemeColors().secondaryText)
          .margin({ top: SPACE_SM.tight })
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }
      .layoutWeight(1)
      .alignItems(HorizontalAlign.Start)
      .padding({ left: SPACE_SM.base, right: SPACE_SM.compact })
    }
    .width('100%')
    .padding({ left: SPACE_SM.roomy, right: SPACE_SM.roomy, top: SPACE_SM.cozy, bottom: SPACE_SM.cozy })
    .opacity(this.itemOpacities[index])
    .scale({ x: this.itemScales[index], y: this.itemScales[index] })
    .animation({ duration: 400, curve: LumioTheme.curve(SpringKind.Crisp) })
  }

  build() {
    SheetScaffold({ material: this.material, fallbackColor: this.getThemeColors().surfaceOverlay }) {
      Column() {
        Column() {
          Image($r('app.media.logo'))
          .width(72)
          .height(72)
          .borderRadius(18)
          .margin({ top: SPACE_SM.compact, bottom: SPACE_SM.cozy })
        Text($r('app.string.welcome'))
          .fontSize(TYPE_SM.title1.size)
          .fontWeight(FontWeight.Bold)
          .lineHeight(TYPE_SM.title1.lineHeight)
          .letterSpacing(TYPE_SM.title1.tracking)
          .fontColor(this.getThemeColors().primaryText)
        Text($r('app.string.welcome_sub'))
          .fontSize(TYPE_SM.footnote.size)
          .fontColor(this.getThemeColors().secondaryText)
          .margin({ top: SPACE_SM.compact, bottom: SPACE_SM.base })
      }
      .width('100%')
      .alignItems(HorizontalAlign.Center)

      Column() {
        ForEach(this.features(), (f: OnboardFeature, index: number) => {
          this.featureItem(f, index)
        }, (f: OnboardFeature, index: number) => index.toString())
      }
      .width('100%')
      .margin({ top: SPACE_SM.compact, bottom: SPACE_SM.base })

      Button($r('app.string.get_started'))
        .width('86%')
        .height(48)
        .fontSize(TYPE_SM.headline.size)
        .fontColor(semanticOf(this.isDark).onAccent)
        .backgroundColor(this.getThemeColors().accent)
        .borderRadius(24)
        .onClick(() => {
          this.onClose();
        }).clickEffect({ level: ClickEffectLevel.LIGHT, scale: 0.96 })
    }
    .width('100%')
    .height('100%')
    .padding({ top: SPACE_SM.loose, bottom: SPACE_SM.section })
    .justifyContent(FlexAlign.Center)
    }
  }
}
